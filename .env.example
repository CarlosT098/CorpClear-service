# Local profile defaults. Export these variables when running from the IDE or Maven.
# Spring Boot does not load .env files automatically.
# Docker Compose loads .env automatically; no .env is required for its defaults.
# POSTGRES_PORT publishes the database on the host; containers use postgres:5432.
# Database credentials initialize a new volume only. Existing volumes keep their credentials.
SPRING_PROFILES_ACTIVE=local
API_PORT=8080
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=corpclear
POSTGRES_USER=corpclear
POSTGRES_PASSWORD=corpclear_local
