<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="004-create-organizational-indexes" author="carlost098">
        <createIndex tableName="users" indexName="idx_users_department_id" unique="false" using="btree">
            <column name="department_id"/>
        </createIndex>
        <createIndex tableName="users" indexName="idx_users_manager_id" unique="false" using="btree">
            <column name="manager_id"/>
        </createIndex>
        <createIndex tableName="departments" indexName="idx_departments_manager_id" unique="false" using="btree">
            <column name="manager_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="departments" indexName="idx_departments_manager_id"/>
            <dropIndex tableName="users" indexName="idx_users_manager_id"/>
            <dropIndex tableName="users" indexName="idx_users_department_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
