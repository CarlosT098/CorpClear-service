<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="003-create-organizational-foreign-keys" author="carlost098">
        <addForeignKeyConstraint baseTableName="users" baseColumnNames="department_id"
                                 referencedTableName="departments" referencedColumnNames="id"
                                 constraintName="fk_users_department" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 deferrable="false" initiallyDeferred="false" validate="true"/>
        <addForeignKeyConstraint baseTableName="users" baseColumnNames="manager_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_users_manager" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 deferrable="false" initiallyDeferred="false" validate="true"/>
        <addForeignKeyConstraint baseTableName="departments" baseColumnNames="manager_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_departments_manager" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 deferrable="false" initiallyDeferred="false" validate="true"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="departments" constraintName="fk_departments_manager"/>
            <dropForeignKeyConstraint baseTableName="users" constraintName="fk_users_manager"/>
            <dropForeignKeyConstraint baseTableName="users" constraintName="fk_users_department"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
