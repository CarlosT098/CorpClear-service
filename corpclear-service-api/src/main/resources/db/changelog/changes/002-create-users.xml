<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="002-create-users" author="carlost098">
        <createTable tableName="users">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_users" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="department_id" type="UUID"/>
            <column name="manager_id" type="UUID"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE users
                ADD CONSTRAINT ck_users_name_not_empty CHECK (btrim(name) &lt;&gt; ''),
                ADD CONSTRAINT ck_users_name_trimmed CHECK (name = btrim(name)),
                ADD CONSTRAINT ck_users_email_not_empty CHECK (btrim(email) &lt;&gt; ''),
                ADD CONSTRAINT ck_users_email_trimmed CHECK (email = btrim(email)),
                ADD CONSTRAINT ck_users_password_hash_not_empty CHECK (btrim(password_hash) &lt;&gt; ''),
                ADD CONSTRAINT ck_users_role CHECK (role IN ('EMPLOYEE', 'MANAGER', 'FINANCE', 'AUDITOR', 'ADMIN')),
                ADD CONSTRAINT ck_users_status CHECK (status IN ('ACTIVE', 'BLOCKED', 'DISABLED')),
                ADD CONSTRAINT ck_users_employee_links CHECK (role &lt;&gt; 'EMPLOYEE' OR (department_id IS NOT NULL AND manager_id IS NOT NULL)),
                ADD CONSTRAINT ck_users_no_self_management CHECK (manager_id &lt;&gt; id);
        </sql>
        <createIndex tableName="users" indexName="ux_users_email_lower" unique="true">
            <column name="lower(email)" computed="true"/>
        </createIndex>
        <rollback>
            <dropTable tableName="users" cascadeConstraints="false"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
